# ==============================================================================
# LMS Estudiantil - Configuración de Servidor Web (.htaccess)
# Restricción y Protección de Recursos del Sistema
# ==============================================================================

# 1. Deshabilitar listado de directorios
Options -Indexes

# 2. Proteger archivos ocultos y de configuración sensible (.env, .git, .log, .json, .cs)
<FilesMatch "(^\.|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|cs|csproj|json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Denegar acceso directo a este mismo archivo
<Files ".htaccess">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# 4. Cabeceras de Seguridad HTTP
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

# 5. Reescribir URLs para enrutamiento SPA / API (Apache Reverse Proxy / Rewrite)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forzar HTTPS si está disponible
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Redirección de peticiones al Backend Kestrel si opera como Proxy Reverso
    # RewriteRule ^api/(.*)$ http://localhost:5000/api/$1 [P,L]
</IfModule>

# 6. Compresión GZIP / Deflate para optimización de entrega
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/json application/javascript
</IfModule>
