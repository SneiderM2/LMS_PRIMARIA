{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;lms-primaria.onrender.com;*.onrender.com;sneiderm2.github.io",
  "ConnectionStrings": {
    "DefaultConnection": "__ENV_DATABASE_URL__"
  },
  "Jwt": {
    "SecretKey": "__ENV_JWT_SECRET_KEY__",
    "Issuer": "LMS.API",
    "Audience": "LMS.Client",
    "ExpirationMinutes": 480
  },
  "Authentication": {
    "Google": {
      "ClientId": "__ENV_GOOGLE_CLIENT_ID__"
    }
  },
  "Recaptcha": {
    "SiteKey": "__ENV_RECAPTCHA_SITE_KEY__",
    "SecretKey": "__ENV_RECAPTCHA_SECRET_KEY__",
    "ExpectedHostname": "",
    "AllowDevBypass": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://sneiderm2.github.io",
      "http://localhost:4200",
      "http://127.0.0.1:4200"
    ]
  },
  "Privacy": {
    "PolicyVersion": "2026-10-19",
    "PolicyEffectiveDate": "2026-10-19",
    "PolicyUrl": "https://sneiderm2.github.io/LMS_PRIMARIA/privacidad.html",
    "ControllerName": "Institución Educativa — LMS Primaria",
    "ControllerNit": "Por definir",
    "ControllerAddress": "Colombia",
    "ContactEmail": "privacidad@lmsprimaria.edu.co",
    "ContactPhone": "Por definir",
    "DpoName": "Oficial de Protección de Datos",
    "RequireGuardianConsentForMinors": true,
    "AcademicRetentionYears": 5,
    "LogRetentionDays": 90,
    "InactivityAnonymizationMonths": 36,
    "EnableInactivityAnonymization": false,
    "InactivityAnonymizationDryRun": true,
    "EvidenceHmacKey": "__ENV_EVIDENCE_HMAC_KEY__"
  },
  "Registration": {
    "TeacherInviteCode": "__ENV_TEACHER_INVITE_CODE__",
    "AllowPublicStudentRegistration": true
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "",
    "MaxFileSizeBytes": 26214400,
    "MaxFilesPerSubmission": 5,
    "AllowLocalFallback": false,
    "Supabase": {
      "Url": "__ENV_SUPABASE_URL__",
      "ServiceRoleKey": "__ENV_SUPABASE_SERVICE_ROLE_KEY__",
      "Bucket": "lms-uploads"
    }
  },
  "Features": {
    "EnableDatabaseRestore": false
  },
  "Seed": {
    "Enabled": false,
    "AllowInProduction": false,
    "AdminPassword": "__ENV_SEED_ADMIN_PASSWORD__",
    "TeacherPassword": "__ENV_SEED_TEACHER_PASSWORD__",
    "StudentPassword": "__ENV_SEED_STUDENT_PASSWORD__"
  },
  "Database": {
    "TrustServerCertificate": false
  },
  "Supabase": {
    "ProjectRef": "__ENV_SUPABASE_PROJECT_REF__",
    "PoolerHost": "aws-0-us-east-1.pooler.supabase.com"
  }
}
