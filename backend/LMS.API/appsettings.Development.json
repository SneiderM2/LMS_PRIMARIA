{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Recaptcha": {
    "SiteKey": "__ENV_RECAPTCHA_SITE_KEY__",
    "SecretKey": "__ENV_RECAPTCHA_SECRET_KEY__",
    "AllowDevBypass": true
  },
  "Features": {
    "EnableDatabaseRestore": true
  },
  "Seed": {
    "Enabled": false
  }
}
