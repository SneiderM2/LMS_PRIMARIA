{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chrome"
      ],
      "enabled": true
    }
  }
}