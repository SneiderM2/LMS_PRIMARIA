# =============================================================================
# LMS PRIMARIA — Variables de Entorno para Despliegue (Render & Supabase)
# =============================================================================
# IMPORTANTE:
# 1. NUNCA suba un archivo .env real ni appsettings.Local.json al repositorio.
# 2. En Render (Web Service -> Environment), configure estas variables.
# 3. En desarrollo local, use User Secrets (`dotnet user-secrets`) o
#    `backend/LMS.API/appsettings.Local.json` (ignorado por Git).
# =============================================================================

# --- Entorno de Ejecución .NET ---
ASPNETCORE_ENVIRONMENT=Production
PORT=8080

# --- Base de Datos PostgreSQL (Supabase Session Pooler / Direct) ---
# Formato URI recomendado para Render + Supabase Pooler (IPv4 compatible):
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
ConnectionStrings__DefaultConnection=Host=aws-0-us-east-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<PROJECT_REF>;Password=<DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=false;
SUPABASE_PROJECT_REF=<PROJECT_REF>
SUPABASE_POOLER_HOST=aws-0-us-east-1.pooler.supabase.com
Database__TrustServerCertificate=false

# --- Almacenamiento de Archivos Privados (Supabase Storage) ---
STORAGE_PROVIDER=Supabase
Storage__Provider=Supabase
Storage__AllowLocalFallback=false
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_SECRET_KEY>
SUPABASE_STORAGE_BUCKET=lms-uploads

# --- Seguridad JWT (Mínimo 48 caracteres aleatorios de alta entropía) ---
# Generar con: openssl rand -base64 64
Jwt__SecretKey=<GENERAR_CLAVE_JWT_MINIMO_48_CARACTERES>
Jwt__Issuer=LMS.API
Jwt__Audience=LMS.Client
Jwt__ExpirationMinutes=480

# --- Cumplimiento Legal Habeas Data (Ley 1581 de 2012 / Ley 1098 de 2006) ---
# Clave HMAC dedicada para firmar evidencias de consentimiento (DISTINTA de Jwt__SecretKey, mín. 32 chars)
EVIDENCE_HMAC_KEY=<GENERAR_CLAVE_HMAC_EVIDENCIA_MINIMO_32_CARACTERES>
Privacy__EvidenceHmacKey=<GENERAR_CLAVE_HMAC_EVIDENCIA_MINIMO_32_CARACTERES>
Privacy__PolicyVersion=2026-10-19
Privacy__ControllerName=Institución Educativa — LMS Primaria
Privacy__ControllerNit=<NIT_INSTITUCION>
Privacy__ContactEmail=privacidad@colegio.edu.co
Privacy__ContactPhone=<TELEFONO_INSTITUCION>
Privacy__DpoName=<NOMBRE_OFICIAL_PROTECCION_DATOS>
Privacy__RequireGuardianConsentForMinors=true

# --- Protección Anti-Bots (Google reCAPTCHA v2/v3) ---
RECAPTCHA_SITE_KEY=<GOOGLE_RECAPTCHA_SITE_KEY>
RECAPTCHA_SECRET_KEY=<GOOGLE_RECAPTCHA_SECRET_KEY>
Recaptcha__SiteKey=<GOOGLE_RECAPTCHA_SITE_KEY>
Recaptcha__SecretKey=<GOOGLE_RECAPTCHA_SECRET_KEY>
Recaptcha__ExpectedHostname=sneiderm2.github.io
Recaptcha__AllowDevBypass=false

# --- OAuth Institucional y Registro ---
Authentication__Google__ClientId=<GOOGLE_OAUTH_CLIENT_ID>
Registration__TeacherInviteCode=<CODIGO_INVITACION_DOCENTES>
Registration__AllowPublicStudentRegistration=true

# --- CORS Estricto (Orígenes permitidos separados por coma) ---
CORS_ALLOWED_ORIGINS=https://sneiderm2.github.io
