# =============================================================================
# LMS PRIMARIA — Variables de Entorno para Despliegue (Render & Supabase)
# =============================================================================
# IMPORTANTE:
# 1. NUNCA suba un archivo .env real ni appsettings.Local.json al repositorio.
# 2. En Render (Web Service -> Environment), reemplace cada placeholder.
# 3. En desarrollo local, use User Secrets (`dotnet user-secrets`) o
#    `backend/LMS.API/appsettings.Local.json` (ignorado por Git).
# =============================================================================

# --- Entorno de Ejecución .NET ---
ASPNETCORE_ENVIRONMENT=<REEMPLAZAR_EN_RENDER>
PORT=<REEMPLAZAR_EN_RENDER>

# --- Base de Datos PostgreSQL (Supabase Session Pooler / Direct) ---
DATABASE_URL=<REEMPLAZAR_EN_RENDER>
ConnectionStrings__DefaultConnection=<REEMPLAZAR_EN_RENDER>
SUPABASE_PROJECT_REF=<REEMPLAZAR_EN_RENDER>
SUPABASE_POOLER_HOST=<REEMPLAZAR_EN_RENDER>
Database__TrustServerCertificate=<REEMPLAZAR_EN_RENDER>

# --- Almacenamiento de Archivos Privados (Supabase Storage) ---
STORAGE_PROVIDER=<REEMPLAZAR_EN_RENDER>
Storage__Provider=<REEMPLAZAR_EN_RENDER>
Storage__AllowLocalFallback=<REEMPLAZAR_EN_RENDER>
SUPABASE_URL=<REEMPLAZAR_EN_RENDER>
SUPABASE_SERVICE_ROLE_KEY=<REEMPLAZAR_EN_RENDER>
SUPABASE_STORAGE_BUCKET=<REEMPLAZAR_EN_RENDER>

# --- Seguridad JWT (Mínimo 48 caracteres aleatorios de alta entropía) ---
Jwt__SecretKey=<REEMPLAZAR_EN_RENDER>
Jwt__Issuer=<REEMPLAZAR_EN_RENDER>
Jwt__Audience=<REEMPLAZAR_EN_RENDER>
Jwt__ExpirationMinutes=<REEMPLAZAR_EN_RENDER>

# --- Cumplimiento Legal Habeas Data (Ley 1581 de 2012 / Ley 1098 de 2006) ---
EVIDENCE_HMAC_KEY=<REEMPLAZAR_EN_RENDER>
Privacy__EvidenceHmacKey=<REEMPLAZAR_EN_RENDER>
Privacy__PolicyVersion=<REEMPLAZAR_EN_RENDER>
Privacy__ControllerName=<REEMPLAZAR_EN_RENDER>
Privacy__ControllerNit=<REEMPLAZAR_EN_RENDER>
Privacy__ContactEmail=<REEMPLAZAR_EN_RENDER>
Privacy__ContactPhone=<REEMPLAZAR_EN_RENDER>
Privacy__DpoName=<REEMPLAZAR_EN_RENDER>
Privacy__RequireGuardianConsentForMinors=<REEMPLAZAR_EN_RENDER>

# --- Protección Anti-Bots (Google reCAPTCHA v2/v3) ---
RECAPTCHA_SITE_KEY=<REEMPLAZAR_EN_RENDER>
RECAPTCHA_SECRET_KEY=<REEMPLAZAR_EN_RENDER>
Recaptcha__SiteKey=<REEMPLAZAR_EN_RENDER>
Recaptcha__SecretKey=<REEMPLAZAR_EN_RENDER>
Recaptcha__ExpectedHostname=<REEMPLAZAR_EN_RENDER>
Recaptcha__AllowDevBypass=<REEMPLAZAR_EN_RENDER>

# --- OAuth Institucional y Registro ---
Authentication__Google__ClientId=<REEMPLAZAR_EN_RENDER>
Registration__TeacherInviteCode=<REEMPLAZAR_EN_RENDER>
Registration__AllowPublicStudentRegistration=<REEMPLAZAR_EN_RENDER>

# --- Sembrado Inicial Controlado ---
SEED_DEFAULT_PASSWORD=<REEMPLAZAR_EN_RENDER>

# --- CORS Estricto (Orígenes permitidos separados por coma) ---
CORS_ALLOWED_ORIGINS=<REEMPLAZAR_EN_RENDER>
